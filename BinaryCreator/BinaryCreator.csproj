<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bincrtr</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>$(AssemblyName).dll</PackageId>
    <Version>1.0.1</Version>
    <Title>Binary Creator</Title>
    <Authors>Alec James McKeever</Authors>
    <Company>McKeever Studios</Company>
    <Product>$(AssemblyName).dll</Product>
    <Description>A small c# utility library for creating structured binary files. </Description>
    <Copyright>GNU General Public License</Copyright>
    <PackageIcon></PackageIcon>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReleaseNotes>Fixed reader not reading section amount properly.

Fixed byte to value converters creating spans with incorrect length. (1 less than intended value)</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\ReadMe.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
